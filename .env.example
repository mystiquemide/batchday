# PayPal sandbox REST app (US merchant)
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id printed by npm run webhook:register
PAYPAL_WEBHOOK_ID=
# Gemini API key for supplier update parsing
GEMINI_API_KEY=
# Optional comma-separated Gemini models, tried in order on overload
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite
# HTTP port
PORT=3000
# Public origin used for PayPal return and cancel URLs
PUBLIC_BASE_URL=http://localhost:3000
# SQLite file location
DATABASE_PATH=data/batchday.db
